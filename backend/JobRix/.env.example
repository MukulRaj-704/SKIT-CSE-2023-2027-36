# ---------------------------------------------------------------------------
# JobRix backend environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` (same directory) and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git ignored, so secrets never reach the repository. Generate the
# secret key with:
#
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# ---------------------------------------------------------------------------

# --- Core Django ------------------------------------------------------------
# Required unless DJANGO_DEBUG=True.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send session/CSRF authenticated requests (React dev server).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---------------------------------------------------------------
# Public base URL of the React app. Password reset emails link here.
FRONTEND_URL=http://localhost:5173

# --- Database ---------------------------------------------------------------
# SQLite (default): only the engine and path are used.
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=
DJANGO_DB_CONN_MAX_AGE=0
# PostgreSQL / MySQL example:
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=jobrix
# DJANGO_DB_USER=jobrix
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# --- Email (password reset links) -------------------------------------------
# Local development prints emails to the console: keep the default backend.
# Django 6.1 uses MAILERS instead of the deprecated EMAIL_* settings, hence the
# DJANGO_MAILER_BACKEND name.
DJANGO_MAILER_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@jobrix.local
# Production SMTP example (set DJANGO_MAILER_BACKEND to the SMTP backend first):
# DJANGO_MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_TIMEOUT=10